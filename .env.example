# Client-safe values (visible in the Vite browser bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_ROOT_DOMAIN=hospitalcloud.com

# Server-only values for api/add-custom-domain.js — never prefix these with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
VERCEL_API_TOKEN=YOUR_VERCEL_API_TOKEN
VERCEL_PROJECT_ID=YOUR_VERCEL_PROJECT_ID
# Optional when the Vercel project belongs to a team
VERCEL_TEAM_ID=
